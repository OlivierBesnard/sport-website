{
  "name": "sport-website",
  "version": "0.0.0",
  "private": true,
  "description": "CMS modulaire auto-hébergé pour clubs de sport",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome check",
    "format": "biome check --write",
    "typecheck": "turbo run typecheck && tsc --noEmit",
    "test": "vitest run",
    "build": "turbo run build",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "test:e2e": "turbo run build && playwright test",
    "db:generate": "pnpm --filter @sport-cms/db db:generate",
    "release": "turbo run build --filter=@sport-cms/release --output-logs=errors-only && node packages/release/dist/cli.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@playwright/test": "^1.64.1",
    "@sport-cms/config": "workspace:*",
    "@types/node": "catalog:",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
