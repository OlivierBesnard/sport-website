{
  "name": "sport-website",
  "version": "0.0.0",
  "private": true,
  "description": "CMS modulaire auto-hébergé pour clubs de sport",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome check",
    "format": "biome check --write",
    "typecheck": "turbo run typecheck && tsc --noEmit",
    "test": "vitest run",
    "build": "turbo run build",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@sport-cms/config": "workspace:*",
    "@types/node": "catalog:",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
