{
  "name": "@sport-cms/blocks",
  "version": "0.0.0",
  "private": true,
  "description": "Blocs de page du noyau, au format de l'éditeur Puck, et leur rendu serveur",
  "type": "module",
  "exports": {
    ".": {
      "@sport-cms/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "@sport-cms/source": "./src/server/index.ts",
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "catalog:",
    "sanitize-html": "^2.18.1"
  },
  "devDependencies": {
    "@sport-cms/config": "workspace:*",
    "@sport-cms/themes": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/sanitize-html": "^2.16.2",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
