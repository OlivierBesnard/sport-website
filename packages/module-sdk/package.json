{
  "name": "@sport-cms/module-sdk",
  "version": "0.0.0",
  "private": true,
  "description": "SDK des modules : defineModule, defineBlock, contexte et validation du manifeste",
  "type": "module",
  "exports": {
    ".": {
      "@sport-cms/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sport-cms/blocks": "workspace:*",
    "@sport-cms/core": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@sport-cms/config": "workspace:*",
    "@types/react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
