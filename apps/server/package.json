{
  "name": "@sport-cms/server",
  "version": "0.0.0",
  "private": true,
  "description": "Serveur de l'instance : site public, API du back-office, modules (et, à venir, webhooks et tâches)",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node --enable-source-maps dist/main.js",
    "dev": "tsx watch --tsconfig tsconfig.dev.json --conditions=@sport-cms/source src/main.ts",
    "seed:demo": "tsx --tsconfig tsconfig.dev.json --conditions=@sport-cms/source src/seed-demo.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@sport-cms/blocks": "workspace:*",
    "@sport-cms/core": "workspace:*",
    "@sport-cms/db": "workspace:*",
    "@sport-cms/module-exemple": "workspace:*",
    "@sport-cms/module-loader": "workspace:*",
    "@sport-cms/module-sdk": "workspace:*",
    "@sport-cms/themes": "workspace:*",
    "better-auth": "^1.7.15",
    "drizzle-orm": "catalog:",
    "hono": "^4.13.14",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sharp": "^0.35.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@sport-cms/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
