{
  "name": "@sport-cms/supervisor",
  "version": "0.0.0",
  "private": true,
  "description": "Superviseur de l'instance : reçoit le trafic, installe les mises à jour signées, contrôle de santé et retour arrière",
  "type": "module",
  "exports": {
    ".": {
      "@sport-cms/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node --enable-source-maps dist/main.js"
  },
  "dependencies": {
    "@sport-cms/core": "workspace:*",
    "semver": "^7.8.6",
    "tar": "^7.5.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@sport-cms/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/semver": "^7.8.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
